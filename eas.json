{
  "cli": {
    "version": ">= 20.1.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "medium"
      }
    },
    "diagnostic": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_DIAGNOSTIC_MODE": "true"
      }
    },
    "gate": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_GATE_ONLY": "true"
      }
    },
    "internal": {
      "ios": {
        "distribution": "internal",
        "resourceClass": "medium"
      },
      "android": {
        "buildType": "app-bundle",
        "resourceClass": "medium"
      }
    },
    "apk": {
      "android": {
        "buildType": "apk",
        "resourceClass": "medium"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "resourceClass": "medium"
      },
      "android": {
        "buildType": "app-bundle",
        "resourceClass": "medium"
      }
    }
  },
  "submit": {
    "production": {}
  }
}


